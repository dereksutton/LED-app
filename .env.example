# Site (Next.js) build-time settings. All optional.
# Leave empty in production to call the API through the same-origin rewrite.
NEXT_PUBLIC_API_URL=

# Google Ads conversion tracking (from Google Ads > Goals > Conversions)
NEXT_PUBLIC_GOOGLE_ADS_ID=            # e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=    # label for the "quote form" conversion
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=    # label for the "phone click" conversion

# Meta Pixel ID (from Meta Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=
