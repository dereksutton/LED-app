# API server settings
PORT=3001
MONGO_URI=                                       # required for the /admin dashboard; the quote form still emails without it
RESEND_API_KEY=                                  # also sends dashboard sign-in codes; locally, leave empty to print codes in this terminal
RESEND_FROM_EMAIL=quotes@ledcustompainting.com
LEAD_NOTIFY_EMAIL=ledcustompainting@gmail.com   # where lead alerts go
CORS_ORIGIN=                                     # comma-separated, only needed if the site calls the API cross-origin

# Optional extras, off until set
CUSTOMER_AUTOREPLY=false                         # true = email visitors a "we got your request" note
TWILIO_ACCOUNT_SID=                              # these three set = dashboard sign-in codes can be texted
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                              # your Twilio number, e.g. +19045550100
LEAD_NOTIFY_SMS=                                 # plus this one = text the owner on every lead, e.g. +19045550123

# Dashboard
SITE_URL=https://ledcustompainting.com           # used in customer links; http://localhost:3000 locally
STRIPE_SECRET_KEY=                               # both set = "Pay by card" on invoices (owner's own Stripe account)
STRIPE_WEBHOOK_SECRET=                           # from a Stripe webhook pointed at https://led-app-api.onrender.com/api/stripe/webhook
